# Finnhub API Key for real-time market data
VITE_FINNHUB_API_KEY=your_finnhub_api_key_here

# (Optional) Time-To-Live in hours for morning news trending ticker cache (default: 2 hours)
VITE_NEWS_CACHE_TTL_HOURS=2

# (Optional) Comma-separated list of default stock tickers override (leave blank to auto-discover from morning news)
# VITE_DEFAULT_TICKERS=

# ─── Admin panel ─────────────────────────────────────────────────────────────
# Password for the /#admin panel. Use at least 8 characters.
ADMIN_PASSWORD=change-me-to-a-long-random-password

# (Optional) Admin API server settings
# ADMIN_PORT=8081
# ADMIN_HOST=127.0.0.1
# ADMIN_DEPLOY_DIR=/var/www/html/advisor
# ADMIN_DEPLOY_OWNER=opc:apache
# ADMIN_SESSION_TTL_MS=28800000
# ADMIN_LOGIN_MAX_ATTEMPTS=8
# Set to 0 if the deploy directory is writable without sudo.
# ADMIN_USE_SUDO=1
